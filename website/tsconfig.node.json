{
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "plugins",
    "src/services/posts/frontmatter.ts",
    "src/services/posts/markdown.ts",
    "src/services/posts/posts.types.ts",
    "src/services/posts/search-tokens.ts"
  ]
}
